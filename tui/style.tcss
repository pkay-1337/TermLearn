/* ==========================================================================
   termlearn — Master TCSS Stylesheet
   Theme: Catppuccin Mocha Aurora
   ========================================================================== */

/* --------------------------------------------------------------------------
   Color Palette Variables
   -------------------------------------------------------------------------- */
$crust: #11111b;
$mantle: #181825;
$base: #1e1e2e;
$surface-0: #313244;
$surface-1: #45475a;
$surface-2: #585b70;

$accent-primary: #89b4fa;    /* Sapphire Blue */
$accent-secondary: #cba6f7;  /* Mauve / Soft Violet */
$accent-cyan: #89dceb;       /* Sky / Bright Cyan */

$status-success: #a6e3a1;    /* Emerald Green */
$status-warning: #f9e2af;    /* Warm Amber */
$status-danger: #f38ba8;     /* Coral / Rose */

$text-primary: #cdd6f4;
$text-sub: #bac2de;
$text-muted: #6c7086;

/* --------------------------------------------------------------------------
   Global Screen & Shell
   -------------------------------------------------------------------------- */
Screen {
    background: $crust;
    color: $text-primary;
}

Header {
    dock: top;
    height: 1;
    background: $mantle;
    color: $accent-cyan;
    text-style: bold;
}

Footer {
    dock: bottom;
    height: 1;
    background: $mantle;
    color: $text-sub;
}

.screen-title {
    padding: 0 1;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent-primary;
    background: $mantle;
    border-bottom: solid $surface-0;
}

/* --------------------------------------------------------------------------
   Master-Detail Layouts (Home & Chapters)
   -------------------------------------------------------------------------- */
.master-detail-row {
    layout: horizontal;
    height: 1fr;
}

.sidebar-pane {
    width: 42%;
    height: 1fr;
    background: $mantle;
    border-right: solid $surface-0;
    padding: 0 1;
}

.content-pane {
    width: 58%;
    height: 1fr;
    background: $base;
    padding: 1 2;
    overflow-y: auto;
}

.content-pane:focus {
    border-left: solid $accent-primary;
    background: #232338;
}

/* Narrow / Mobile Single-Pane Mode (< 70 columns) */
.pane-hidden {
    display: none;
}

.pane-full {
    width: 100%;
    border-right: none;
}

.details-card {
    background: $base;
    border: round $surface-0;
    padding: 1 2;
    margin-bottom: 1;
}

.details-header {
    text-style: bold;
    color: $accent-secondary;
    margin-bottom: 1;
}

.details-meta {
    color: $text-sub;
    margin-bottom: 1;
}

.details-section-title {
    text-style: bold;
    color: $accent-cyan;
    margin-top: 1;
    margin-bottom: 0;
}

/* OptionList Styling */
OptionList {
    background: $mantle;
    border: none;
    padding: 0;
}

OptionList > .option-list--option-highlighted {
    background: $surface-1;
    color: $accent-cyan;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $accent-primary;
    color: $crust;
    text-style: bold;
}

/* --------------------------------------------------------------------------
   Chapter Menu
   -------------------------------------------------------------------------- */
.menu-container {
    padding: 1 2;
    height: 1fr;
}

.menu-banner {
    padding: 1;
    background: $mantle;
    border: round $accent-primary;
    color: $text-primary;
    text-align: center;
    margin-bottom: 1;
}

.menu-list-box {
    background: $base;
    border: round $surface-0;
    padding: 1;
}

.menu-list-box:focus-within {
    border: round $accent-cyan;
}

/* --------------------------------------------------------------------------
   Study Screen
   -------------------------------------------------------------------------- */
.study-container {
    padding: 1 2;
    height: 1fr;
}

.study-header-bar {
    background: $mantle;
    border: round $surface-0;
    padding: 0 1;
    margin-bottom: 1;
    color: $accent-secondary;
    text-style: bold;
}

.study-block-card {
    background: $base;
    border: round $surface-0;
    padding: 1 2;
    margin-bottom: 1;
}

.study-example-box {
    background: $crust;
    border: round $accent-primary;
    padding: 1;
    margin: 1 0;
}

.study-viz-box {
    background: $mantle;
    border: dashed $accent-cyan;
    padding: 1;
    margin: 1 0;
}

.study-nav-box {
    margin-top: 1;
    padding: 0 1;
    color: $accent-cyan;
}

/* --------------------------------------------------------------------------
   Quiz & Question Widgets
   -------------------------------------------------------------------------- */
QuestionWidget {
    background: $base;
    border: round $surface-0;
    padding: 1 2;
    margin-bottom: 1;
}

QuestionWidget:focus-within {
    border: round $accent-primary;
}

.question-prompt {
    text-style: bold;
    color: $accent-cyan;
    margin-bottom: 1;
}

QuestionWidget Syntax, .study-example-box Syntax {
    max-height: 14;
    overflow-y: auto;
    overflow-x: auto;
    border: round $surface-1;
    margin: 1 0;
}

ChoiceCard {
    width: 100%;
    height: auto;
    min-height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-0;
    color: $text-primary;
    border: round $surface-1;
}

ChoiceCard:hover {
    background: $surface-1;
    border: round $accent-cyan;
    color: $accent-cyan;
}

ChoiceCard:focus {
    background: $surface-1;
    border: round $accent-primary;
    color: $text-primary;
    text-style: bold;
}

ChoiceCard.choice-card-selected {
    background: $accent-primary;
    color: $crust;
    text-style: bold;
}

.choice-card-text {
    width: 100%;
    height: auto;
    text-wrap: wrap;
}

.question-opt-btn {
    width: 100%;
    margin-bottom: 1;
    background: $surface-0;
    color: $text-primary;
    border: none;
    text-align: left;
}

.question-opt-btn:hover {
    background: $surface-1;
    color: $accent-cyan;
}

.question-opt-btn:focus {
    background: $accent-primary;
    color: $crust;
    text-style: bold;
}

.question-input {
    margin: 1 0;
    background: $mantle;
    border: round $surface-1;
    color: $text-primary;
}

.question-input:focus {
    border: round $accent-cyan;
}

.feedback-msg {
    margin-top: 1;
    padding: 1;
    border: round $surface-0;
}

.feedback-msg-success {
    background: #1e3a29;
    border: round $status-success;
    color: $status-success;
    text-style: bold;
}

.feedback-msg-error {
    background: #3e2025;
    border: round $status-danger;
    color: $status-danger;
}

/* --------------------------------------------------------------------------
   Cards Screen (SRS Flashcard Deck)
   -------------------------------------------------------------------------- */
.cards-outer {
    align: center middle;
    height: 1fr;
    padding: 1;
}

.flashcard-frame {
    width: 95%;
    max-width: 82;
    min-width: 28;
    min-height: 12;
    height: auto;
    max-height: 65vh;
    background: $base;
    border: heavy $accent-primary;
    padding: 1 2;
    margin-bottom: 1;
    overflow-y: auto;
}

.flashcard-flipped {
    border: heavy $accent-secondary;
}

.card-tag {
    color: $accent-secondary;
    text-style: bold;
    border-bottom: solid $surface-0;
    padding-bottom: 1;
    margin-bottom: 1;
}

.card-content {
    color: $text-primary;
    margin: 1 0;
}

.card-hint {
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

.grade-deck {
    layout: horizontal;
    align: center middle;
    height: auto;
    margin-top: 1;
}

.grade-deck > Button {
    margin: 0 1 1 0;
}

.grade-deck-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1;
    width: 100%;
    max-width: 50;
    height: auto;
    margin-top: 1;
    align: center middle;
}

.btn-grade-1 {
    background: $status-danger;
    color: $crust;
    text-style: bold;
    margin-right: 1;
}

.btn-grade-2 {
    background: $status-warning;
    color: $crust;
    text-style: bold;
    margin-right: 1;
}

.btn-grade-3 {
    background: $accent-primary;
    color: $crust;
    text-style: bold;
    margin-right: 1;
}

.btn-grade-4 {
    background: $status-success;
    color: $crust;
    text-style: bold;
}

/* --------------------------------------------------------------------------
   Lab Screen (Mini-IDE)
   -------------------------------------------------------------------------- */
.lab-container {
    height: 1fr;
    padding: 0 1;
}

.lab-split-top {
    layout: horizontal;
    height: 60%;
    margin-bottom: 1;
}

.lab-info-pane {
    width: 38%;
    height: 100%;
    background: $mantle;
    border: round $surface-0;
    padding: 1;
    overflow-y: auto;
    margin-right: 1;
}

.lab-editor-pane {
    width: 62%;
    height: 100%;
    background: $base;
    border: round $accent-primary;
    padding: 0;
}

.lab-actions-bar {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.lab-actions-bar > Button {
    margin-right: 1;
}

.lab-console-pane {
    height: 40%;
    background: $crust;
    border: round $surface-0;
    padding: 1;
    overflow-y: auto;
}

/* --------------------------------------------------------------------------
   Stats Screen (Analytics Dashboard)
   -------------------------------------------------------------------------- */
.stats-container {
    padding: 1 2;
    height: 1fr;
}

.kpi-row {
    layout: horizontal;
    height: 5;
    margin-bottom: 1;
}

.kpi-card {
    width: 1fr;
    height: 100%;
    background: $mantle;
    border: round $surface-0;
    padding: 0 1;
    margin-right: 1;
    align: center middle;
}

.kpi-card:last-of-type {
    margin-right: 0;
}

.kpi-label {
    color: $text-muted;
    text-style: bold;
    text-align: center;
}

.kpi-value {
    color: $accent-cyan;
    text-style: bold;
    text-align: center;
}

DataTable {
    background: $base;
    border: round $surface-0;
    margin-bottom: 1;
}

DataTable > .datatable--header {
    background: $mantle;
    color: $accent-secondary;
    text-style: bold;
}

/* --------------------------------------------------------------------------
   Help Modal Overlay
   -------------------------------------------------------------------------- */
HelpModal {
    align: center middle;
}

#help-box {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $mantle;
    border: double $accent-secondary;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    color: $accent-cyan;
    border-bottom: solid $surface-0;
    padding-bottom: 1;
    margin-bottom: 1;
    text-align: center;
}

#help-close {
    margin-top: 1;
    width: 100%;
    background: $accent-primary;
    color: $crust;
    text-style: bold;
}

/* General Button Styles */
Button {
    background: $surface-1;
    color: $text-primary;
    border: none;
}

Button:hover {
    background: $surface-2;
    color: $accent-cyan;
}

Button:focus {
    background: $accent-primary;
    color: $crust;
    text-style: bold;
}

#next-btn {
    background: $status-success;
    color: $crust;
    text-style: bold;
    margin-top: 1;
}
